{
  "name": "minigames",
  "version": "1.0.0",
  "description": "MiniGames \u2014 a responsive single-page web application built with TypeScript, Sass, and modern frontend development tools.",
  "main": "index.js",
  "scripts": {
    "test:dialogs": "vitest run tests/dialog-routing/",
    "test:details": "vitest run tests/game-details/",
    "test:pagination": "vitest run tests/pagination/",
    "test:filters": "vitest run tests/library-controls/",
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/copy-spa-fallback.mjs",
    "test:router": "vitest run tests/router/",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:api": "vitest run tests/api/",
    "test:ui": "vitest run tests/feedback/",
    "test:home": "vitest run tests/home/",
    "test:library": "vitest run tests/library/",
    "typecheck:feedback": "tsc -p tsconfig.feedback.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gafursz/Minigames.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Gafursz/Minigames/issues"
  },
  "homepage": "https://github.com/Gafursz/Minigames#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.1",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

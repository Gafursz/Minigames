{
  "name": "minigames",
  "version": "1.0.0",
  "description": "MiniGames — a responsive single-page web application built with TypeScript, Sass, and modern frontend development tools.",
  "main": "index.js",
  "scripts": {
    "test:details": "node --test --experimental-test-isolation=none tests/game-details/*.test.mjs",
    "test:pagination": "node --test --experimental-test-isolation=none tests/pagination/*.test.mjs",
    "test:filters": "node --test --experimental-test-isolation=none tests/library-controls/*.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/copy-spa-fallback.mjs",
    "test:router": "node --test --experimental-test-isolation=none tests/router/*.test.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:api": "node --test --experimental-test-isolation=none tests/api/*.test.mjs",
    "test:ui": "node --test --experimental-test-isolation=none tests/feedback/*.test.mjs",
    "test:home": "node --test --experimental-test-isolation=none tests/home/*.test.mjs",
    "test:library": "node --test --experimental-test-isolation=none tests/library/*.test.mjs",
    "typecheck:feedback": "tsc -p tsconfig.feedback.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gafursz/Minigames.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Gafursz/Minigames/issues"
  },
  "homepage": "https://github.com/Gafursz/Minigames#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "jsdom": "30.1.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

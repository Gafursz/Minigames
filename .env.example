# Public Firebase web-app settings from Project settings > General > Your apps.
# Copy this file to .env.local and fill in your own project's values.
# Never put service-account keys, passwords, or Firebase user tokens here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
